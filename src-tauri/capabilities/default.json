{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window only receives core Tauri capabilities.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/chotgpt/cursor-usage-viewer" },
        { "url": "https://github.com/chotgpt/cursor-usage-viewer/releases" },
        { "url": "https://github.com/chotgpt/cursor-usage-viewer/releases/*" },
        { "url": "https://cursor.com/loginDeepControl?challenge=*&uuid=*&mode=login" }
      ]
    }
  ]
}
